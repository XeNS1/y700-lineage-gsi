diff --git a/libsepol/src/write.c b/libsepol/src/write.c
index c6c1410ed4b1e3503df2d901575e14ab2173a4b7..f49908de98b28b7c7f30e6f21a8e9b3d1fdf48f8 100644
--- a/libsepol/src/write.c
+++ b/libsepol/src/write.c
@@ -116,6 +116,14 @@ static int avtab_write_item(policydb_t * p,
 				&& p->policyvers < POLICYDB_VERSION_AVTAB);
 	unsigned int i;
 
+	/* On GSI builds running on kernels that lack ioctl xperms support,
+	   the policy version is capped below POLICYDB_VERSION_XPERMS_IOCTL.
+	   Skip xperms entries entirely during write; they can't be enforced
+	   on such kernels anyway. */
+	if (!oldvers && (p->policyvers < POLICYDB_VERSION_XPERMS_IOCTL) &&
+			(cur->key.specified & AVTAB_XPERMS)) {
+		return POLICYDB_SUCCESS;
+	}
 	if (oldvers) {
 		/* Generate the old avtab format.
 		   Requires merging similar entries if uncond avtab. */
@@ -303,7 +311,20 @@ static int avtab_write(struct policydb *p, avtab_t * a, struct policy_file *fp)
 		nel = a->nel;
 	} else {
 		/* New avtab format.  nel is good to go. */
-		nel = cpu_to_le32(a->nel);
+		uint32_t xperms_count = 0;
+		if (p->policyvers < POLICYDB_VERSION_XPERMS_IOCTL) {
+			/* count xperms entries so we can subtract them from nel.
+			   avtab_write_item skips them when policyvers is below
+			   POLICYDB_VERSION_XPERMS_IOCTL, so nel must reflect the
+			   actual number of entries written. */
+			for (i = 0; i < a->nslot; i++) {
+				for (cur = a->htable[i]; cur; cur = cur->next) {
+					if (cur->key.specified & AVTAB_XPERMS)
+						xperms_count++;
+				}
+			}
+		}
+		nel = cpu_to_le32(a->nel - xperms_count);
 		items = put_entry(&nel, sizeof(uint32_t), 1, fp);
 		if (items != 1)
 			return POLICYDB_ERROR;
